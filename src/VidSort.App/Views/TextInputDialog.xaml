<Window x:Class="VidSort.App.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入分类名"
        Width="420"
        Height="160"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF1C1C1C"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="NameTextBox"
                 Height="26"
                 Padding="6,3"
                 VerticalContentAlignment="Center"
                 Background="#FF2A2A2A"
                 BorderBrush="#66FFFFFF"
                 CaretBrush="White"
                 Foreground="White"
                 FontSize="13"
                 TextChanged="NameTextBox_TextChanged" />

        <TextBlock x:Name="ErrorText"
                   Grid.Row="1"
                   Margin="0,4,0,0"
                   Foreground="#FFFF6B6B"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="3"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="OkButton"
                    Width="76"
                    Height="26"
                    Background="#FF333333"
                    BorderBrush="#66FFFFFF"
                    Click="OkButton_Click"
                    Content="确定"
                    Foreground="White"
                    IsDefault="True" />
            <Button Width="76"
                    Height="26"
                    Margin="8,0,0,0"
                    Background="#FF333333"
                    BorderBrush="#66FFFFFF"
                    Click="CancelButton_Click"
                    Content="取消"
                    Foreground="White"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
